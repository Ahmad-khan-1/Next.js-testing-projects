# Ignore dependency directories
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
**/.yarn/cache
**/.yarn/build-state.yml
**/.yarn/install-state.gz
**/.yarn/**/integrity

# Ignore Next.js build folders
**/.next/
**/out/
**/dist/
**/build/

# Ignore environment files
**/.env
**/.env.*

# Ignore logs and debug files
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Ignore editor / OS files
.vscode/
.DS_Store
Thumbs.db

# Ignore test coverage
**/coverage/

# Ignore Vercel and deployment artifacts
**/.vercel/

# Ignore TypeScript build artifacts
**/*.tsbuildinfo
**/next-env.d.ts

# Ignore PEM/key files
**/*.pem
